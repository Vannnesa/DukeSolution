    {
      "label": "Checking for unsigned power (unsigned x, unsigned y)",
      "pattern": "unsigned\\s+power\\s*\\(\\s*unsigned\\s+x\\s*,\\s*unsigned\\s+y\\s*\\)"
    },
    {
      "label": "Checking that power is recursive",
      "pattern": "unsigned\\s+power\\s*\\([^)]*\\)\\s*\\{[\\s\\S]*?\\bpower\\s*\\("
    }
  ],
  "forbiddenPatterns": [
    {
      "label": "Checking for no iteration (do, while, for)",
      "pattern": "\\b(do|while|for)\\b"
    }
  ],
  "header": "Attempting to compile power.o with our main",
